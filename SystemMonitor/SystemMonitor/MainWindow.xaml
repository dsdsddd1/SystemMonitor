<Window x:Class="SystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统监控"
        Width="250" Height="200"
        WindowStartupLocation="Manual"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False">
    
    <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            CornerRadius="8"
            Opacity="0.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title -->
            <TextBlock Grid.Row="0" Text="系统监控" 
                       FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            
            <!-- CPU Section -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="CPU 占用" Width="70"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock x:Name="CpuUsageText" Text="--"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="CPU 温度" Width="70"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock x:Name="CpuTemperatureText" Text="--"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
            
            <!-- GPU Section -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="GPU 占用" Width="70"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock x:Name="GpuUsageText" Text="--"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="GPU 温度" Width="70"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock x:Name="GpuTemperatureText" Text="--"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="显存占用" Width="70"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock x:Name="GpuMemoryText" Text="--"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
            
            <!-- Memory Section -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="内存占用" Width="70"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <TextBlock x:Name="MemoryText" Text="--"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>